{
  "name": "synthie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev -w @synthie/web",
    "dev:api": "npm run dev -w @synthie/api",
    "build": "npm run build --workspaces --if-present && npm run check:secrets",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "preview": "npm run preview -w @synthie/web",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "test": "npm run test --workspaces --if-present"
  }
}
