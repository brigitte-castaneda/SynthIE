  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@synthie/contracts": "*",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2"
  }
}
