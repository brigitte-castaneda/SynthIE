# Copy to .env.local at the repository root and fill in.
# These values are read ONLY by apps/api. Nothing here is sent to the browser.

# Which model provider the API uses: gemini | ollama
LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-3-pro-preview / llama3.2)
# LLM_MODEL=

# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Used when LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# API server
API_PORT=8787
# Deadline for one model call, in milliseconds
# LLM_TIMEOUT_MS=180000
# Per-client limit on model-backed requests (0 disables)
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=600000
